#!/usr/bin/env bash

# 1. Definisi Fungsi
get_monitor() {
    (driftwm msg state | awk '$1 == "DP-1" || $2 == "DP-1" {print "DP-1"}') 2>/dev/null | head -n 1
}

get_active_monitor() {
    # LOGIKA BARU: Hanya aktifkan pencarian jika sudah melewati kata 'outputs'
    (driftwm msg state | awk '/^outputs/ {in_outputs=1} in_outputs && $1 == "*" {print $2}') 2>/dev/null | head -n 1
}

# 2. Skrip Utama (Main Loop)
while true; do
    output=$(get_monitor)

    # Loop penahan: Diam selama monitor DP-1 tidak terdeteksi (kosong)
    while [[ -z "$output" ]]; do
        output=$(get_monitor)
        sleep 1
    done

    # Kondisi ketika monitor DP-1 terdeteksi baru saja TERHUBUNG
    if [[ "$output" == "DP-1" ]]; then        
        # Cek monitor mana yang memegang tanda bintang '*' di bagian outputs
        active_now=$(get_active_monitor)

        # HANYA jalankan perintah jika monitor kedua (DP-1) langsung menjadi yang aktif/fokus
        if [[ "$active_now" == "DP-1" ]]; then
            sleep 1
            driftwm msg camera 0 17
        fi

        # Loop pengunci: Tahan skrip di sini selama monitor DP-1 masih dicolok
        while [[ "$output" == "DP-1" ]]; do
            output=$(get_monitor)
            sleep 1
        done
    fi

    sleep 1
done
